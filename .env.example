# ============================================================
# BRAHMO Rules Engine — environment configuration
# Copy to .env.local and fill in as needed.
# ============================================================

# Backend selection: "pglite" (default, embedded Postgres, zero setup)
# or "supabase" (real Supabase project).
BRAHMO_BACKEND=pglite

# Only required when BRAHMO_BACKEND=supabase.
# Get these from Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
